# Copie para .env.local (dev) ou configure em Vercel → Settings → Environment Variables.
# Nenhuma variável é obrigatória para rodar localmente. Valores abaixo são exemplos.

# --- Redis (Upstash) — recomendado em produção -------------------------------
# Compartilha cache e rate limit entre as instâncias da Vercel. Sem isso, os
# dois ficam em memória, por instância (o limite por IP fica mais frouxo e o
# cache some a cada cold start).
# A integração "Upstash for Redis" do Marketplace da Vercel cria
# KV_REST_API_URL / KV_REST_API_TOKEN automaticamente — ambos os nomes funcionam.
# UPSTASH_REDIS_REST_URL=https://exemplo-12345.upstash.io
# UPSTASH_REDIS_REST_TOKEN=troque-pelo-token-real

# --- Cache e rate limit -----------------------------------------------------
# Cache de resultados por URL (ms). Padrão: 1 hora.
CACHE_TTL_MS=3600000
# Rate limit da API pública, por IP (janela fixa).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# --- Análise ----------------------------------------------------------------
# Timeout da navegação até o DOMContentLoaded (ms).
ANALYSIS_NAVIGATION_TIMEOUT_MS=25000
# Espera extra para a rede "acalmar" depois de carregar (ms, melhor esforço).
ANALYSIS_SETTLE_TIMEOUT_MS=5000
# Prazo total de uma análise (ms). Precisa ser menor que o maxDuration (60s).
ANALYSIS_TOTAL_TIMEOUT_MS=45000
# Análises simultâneas por instância.
MAX_CONCURRENT_ANALYSES=2
# Máximo de bytes que a página analisada pode baixar (todas as requisições).
ANALYSIS_MAX_DOWNLOAD_BYTES=31457280

# --- Só fora da Vercel ------------------------------------------------------
# Chrome/Chromium a usar localmente (opcional; por padrão usa o do pacote puppeteer).
# CHROME_EXECUTABLE_PATH=/usr/bin/chromium
# Necessário só em containers rodando como root.
# CHROME_NO_SANDBOX=true
# Ler o IP do cliente de X-Forwarded-For. Só ative atrás de um proxy confiável
# que sobrescreva esse cabeçalho. (Na Vercel isso já é automático.)
# TRUST_PROXY_HEADERS=true
